---
import { ArrowUp } from '@lucide/astro';
import { whatsapp } from '../../config/site';
---

{
  whatsapp.communityUrl && (
<a
  href={whatsapp.communityUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float tooltip-host fixed bottom-6 left-6 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-brand-navy text-white shadow-xl"
  aria-label={whatsapp.tooltip}
>
  <img src={whatsapp.communityIcon} alt="" class="h-6 w-6 brightness-0 invert" />
  <span class="whatsapp-tooltip" aria-hidden="true">{whatsapp.tooltip}</span>
</a>
  )
}

<button
  id="back-to-top"
  class="back-to-top fixed bottom-6 right-6 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-brand-blue text-xl font-bold text-white shadow-xl"
  type="button"
  aria-label="Voltar ao topo"
>
  <ArrowUp size={22} stroke-width={2.5} />
</button>

<script>
  const backToTop = document.getElementById('back-to-top');

  const update = () => backToTop?.classList.toggle('is-visible', window.scrollY > 420);
  window.addEventListener('scroll', update, { passive: true });
  update();

  backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
