---
import { ChevronUp, Music, Pause, Play, Square } from '@lucide/astro';
import { jingles } from '../../data/jingles';

const [first] = jingles;
---

{
  first && (
    <aside id="jingle-player" class="jingle-player accessibility-reading-hide" aria-label="Player de músicas da campanha">
      <button class="jingle-toggle" type="button" aria-expanded="false" aria-controls="jingle-panel" data-jingle-toggle>
        <span class="flex min-w-0 items-center gap-2">
          <Music class="jingle-toggle-icon" size={14} stroke-width={2.5} />
          Jingles
        </span>
        <ChevronUp class="jingle-chevron" size={16} stroke-width={2.5} />
      </button>

      <div id="jingle-panel" class="jingle-panel" hidden>
        <div class="jingle-current">
          <div class="min-w-0">
            <small>Jingle tema</small>
            <strong data-jingle-title>{first.title}</strong>
          </div>
          <button class="jingle-control" type="button" aria-label="Ouvir música" data-jingle-play>
            <Play size={14} fill="currentColor" data-icon="play" />
            <Pause class="hidden" size={14} fill="currentColor" data-icon="pause" />
          </button>
          <button class="jingle-control is-stop" type="button" aria-label="Parar música" data-jingle-stop>
            <Square size={12} fill="currentColor" />
          </button>
        </div>
        <audio preload="none" src={first.url} data-jingle-audio />
        <ul class="jingle-list" aria-label="Outras músicas">
          {jingles.map((jingle, index) => (
            <li class:list={['jingle-item', index === 0 && 'is-active']} data-jingle-url={jingle.url} data-jingle-name={jingle.title}>
              <button type="button" class="min-w-0 text-left" data-jingle-select aria-label={`Selecionar ${jingle.title}`}>
                <strong>{jingle.title}</strong>
                <small>{jingle.subtitle}</small>
              </button>
              <a class="jingle-download" href={jingle.url} download>
                Baixar
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

<script>
  const player = document.getElementById('jingle-player');

  if (player) {
    const toggle = player.querySelector<HTMLButtonElement>('[data-jingle-toggle]')!;
    const panel = player.querySelector<HTMLElement>('#jingle-panel')!;
    const audio = player.querySelector<HTMLAudioElement>('[data-jingle-audio]')!;
    const playButton = player.querySelector<HTMLButtonElement>('[data-jingle-play]')!;
    const playIcon = playButton.querySelector<SVGElement>('[data-icon="play"]')!;
    const pauseIcon = playButton.querySelector<SVGElement>('[data-icon="pause"]')!;
    const stopButton = player.querySelector<HTMLButtonElement>('[data-jingle-stop]')!;
    const title = player.querySelector<HTMLElement>('[data-jingle-title]')!;
    const items = [...player.querySelectorAll<HTMLElement>('.jingle-item')];

    const setPlaying = (playing: boolean) => {
      playIcon.classList.toggle('hidden', playing);
      pauseIcon.classList.toggle('hidden', !playing);
      playButton.setAttribute('aria-label', playing ? 'Pausar música' : 'Ouvir música');
    };

    const stop = () => {
      audio.pause();
      audio.currentTime = 0;
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      player.classList.toggle('is-open', open);
      panel.hidden = !open;
    });

    playButton.addEventListener('click', () => {
      if (audio.paused) audio.play().catch(() => setPlaying(false));
      else audio.pause();
    });
    stopButton.addEventListener('click', stop);

    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('ended', () => setPlaying(false));

    items.forEach((item) => {
      item.querySelector('[data-jingle-select]')?.addEventListener('click', () => {
        stop();
        audio.src = item.dataset.jingleUrl ?? '';
        title.textContent = item.dataset.jingleName ?? 'Jingle de campanha';
        items.forEach((entry) => entry.classList.toggle('is-active', entry === item));
      });
    });
  }
</script>
