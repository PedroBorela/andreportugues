---
import { social } from '../../config/site';

interface Props {
  variant: 'nav' | 'footer';
  class?: string;
}

const { variant, class: className } = Astro.props;
// No rodapé o Instagram vem primeiro, como no layout original.
const links = variant === 'footer' ? [...social.filter((s) => s.network === 'instagram'), ...social.filter((s) => s.network !== 'instagram')] : social;
---

<div class:list={['flex items-center gap-2', className]} aria-label="Redes sociais">
  {
    links.map((item) =>
      variant === 'nav' ? (
        <a class="social-nav-link" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
          <img src={item.icon} alt="" width="16" height="16" />
        </a>
      ) : (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.label}
          class="group flex h-10 w-10 items-center justify-center rounded border border-white/60 transition hover:border-brand-yellow hover:bg-brand-yellow"
        >
          <img src={item.icon} alt="" width="16" height="16" class="h-5 w-5 brightness-0 invert group-hover:invert-0" />
        </a>
      ),
    )
  }
</div>
