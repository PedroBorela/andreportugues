---
import { candidate, site } from '../../config/site';

interface Props {
  size?: 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
---

<img
  src={site.logo}
  alt={`${candidate.name} ${candidate.number} — ${candidate.office}`}
  width="1200"
  height="229"
  class:list={['block w-auto', size === 'lg' ? 'h-14 md:h-16' : 'h-9 md:h-11', className]}
/>
