---
import { ChevronRight } from '@lucide/astro';
import { newsletter } from '../../config/site';
import Modal from '../ui/Modal.astro';
---

<section id="newsletter" class="bg-brand-yellow py-16">
  <div class="mx-auto max-w-7xl px-6 md:px-8">
    <div class="reveal flex flex-col justify-between gap-10 rounded-3xl bg-white p-8 shadow-xl md:flex-row md:items-center md:p-12">
      <div class="max-w-xl">
        <p class="mb-2 flex items-center gap-3 text-sm font-extrabold uppercase tracking-eyebrow text-ink">
          <span class="inline-block h-1 w-8 bg-brand-blue"></span>
          EM PRIMEIRA MÃO
        </p>
        <h2 class="text-3xl font-extrabold text-brand-blue md:text-4xl">Receba a agenda e as principais atualizações.</h2>
        <p class="mt-4 text-ink">Cadastre seu e-mail para acompanhar os compromissos e as comunicações oficiais.</p>
      </div>

      <form id="newsletter-form" class="w-full max-w-md" method="post" action={newsletter.endpoint || undefined} novalidate>
        <input type="hidden" name="consent" value="0" data-consent-input />
        <label class="sr-only" for="newsletter-email">Seu melhor e-mail</label>
        <input
          id="newsletter-email"
          name="email"
          required
          type="email"
          autocomplete="email"
          placeholder="Seu melhor e-mail"
          class="w-full rounded-lg border-surface px-4 py-3 focus:border-brand-green focus:ring-brand-green"
        />
        <button
          type="button"
          data-modal-open="newsletter-consent-modal"
          class="newsletter-consent-trigger mt-4 flex w-full items-center justify-between rounded-lg border border-surface px-4 py-3 text-left text-sm text-ink transition hover:border-brand-green hover:bg-surface"
        >
          <span data-consent-label>Autorize o recebimento de comunicações oficiais.</span>
          <ChevronRight class="shrink-0" size={18} />
        </button>
        <button class="btn-green mt-4 w-full rounded-lg py-3 font-extrabold disabled:opacity-60" type="submit">QUERO RECEBER</button>
        <p data-feedback class="mt-3 text-sm font-bold" role="status" hidden></p>
      </form>
    </div>
  </div>
</section>

<Modal id="newsletter-consent-modal" size="sm" eyebrow="COMUNICAÇÃO OFICIAL" title="Autorize o recebimento" closeLabel="Fechar autorização" divider={false}>
  <p class="mt-5 leading-relaxed text-ink">
    Ao autorizar, você concorda em receber por e-mail informações institucionais, agenda e principais atualizações do projeto. Você poderá
    solicitar a interrupção do recebimento a qualquer momento.
  </p>
  <div class="mt-6 flex justify-end gap-3">
    <button class="rounded-lg border border-surface px-4 py-2 text-sm font-bold text-ink" type="button" data-modal-close>Agora não</button>
    <button class="btn-green rounded-lg px-4 py-2 text-sm font-extrabold" type="button" data-consent-approve>Autorizo o recebimento</button>
  </div>
</Modal>

<script>
  import { bindModalTriggers, closeModal, getModal, openModal } from '../../lib/modal';

  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const consentModal = getModal('newsletter-consent-modal');
  const consentInput = form?.querySelector<HTMLInputElement>('[data-consent-input]');
  const consentLabel = form?.querySelector('[data-consent-label]');
  const email = form?.querySelector<HTMLInputElement>('input[type="email"]');
  const feedback = form?.querySelector<HTMLElement>('[data-feedback]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const defaultConsentLabel = consentLabel?.textContent ?? '';

  const showFeedback = (message: string, success: boolean) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.classList.toggle('text-brand-green', success);
    feedback.classList.toggle('text-red-600', !success);
    feedback.hidden = false;
  };

  if (form) bindModalTriggers(form);

  consentModal?.querySelector('[data-consent-approve]')?.addEventListener('click', () => {
    if (consentInput) consentInput.value = '1';
    if (consentLabel) {
      consentLabel.textContent = 'Autorização confirmada para comunicações oficiais.';
      consentLabel.classList.add('font-bold', 'text-brand-green');
    }
    closeModal(consentModal);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!email?.checkValidity()) {
      showFeedback('Informe um e-mail válido.', false);
      email?.focus();
      return;
    }
    if (consentInput?.value !== '1') {
      openModal(consentModal);
      return;
    }
    if (!form.action || form.getAttribute('action') === null) {
      showFeedback('Cadastro indisponível no momento. Tente novamente mais tarde.', false);
      console.warn('Newsletter: defina PUBLIC_NEWSLETTER_ENDPOINT para habilitar o envio.');
      return;
    }

    if (submit) submit.disabled = true;
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      form.reset();
      if (consentInput) consentInput.value = '0';
      if (consentLabel) {
        consentLabel.textContent = defaultConsentLabel;
        consentLabel.classList.remove('font-bold', 'text-brand-green');
      }
      showFeedback('Cadastro realizado! Em breve você receberá nossas atualizações.', true);
    } catch (error) {
      console.error(error);
      showFeedback('Não foi possível concluir o cadastro. Tente novamente.', false);
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
