---
import { ticketCopy } from '../../config/copy';
import { candidate } from '../../config/site';
import { ticket } from '../../data/ticket';
---

<section id="chapa" class="bg-surface py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-6 text-center md:px-8">
    <p class="reveal text-sm font-extrabold uppercase tracking-eyebrow text-brand-blue">{ticketCopy.kicker}</p>
    <h2 class="reveal mt-3 text-4xl font-extrabold uppercase text-brand-navy md:text-6xl">{ticketCopy.title}</h2>

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        ticket.map((item) => (
          <li
            class:list={[
              'reveal flex flex-col items-center rounded-3xl p-8',
              item.highlight ? 'bg-brand-blue text-white shadow-2xl md:-translate-y-3' : 'border border-brand-blue/15 bg-white text-brand-navy',
            ]}
          >
            <span class:list={['text-sm font-extrabold uppercase tracking-eyebrow', item.highlight ? 'text-brand-yellow' : 'text-brand-blue']}>
              {item.office}
            </span>
            <span class:list={['mt-4 font-display font-extrabold leading-none', item.highlight ? 'text-8xl text-brand-yellow' : 'text-7xl']}>
              {item.number}
            </span>
            <span class="mt-3 text-xl font-bold">{item.name}</span>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-10 text-lg font-bold text-brand-navy">
      Dia {candidate.electionDateLabel}, para {candidate.office}, digite <span class="text-brand-blue">{candidate.number}</span> e confirme.
    </p>
  </div>
</section>
