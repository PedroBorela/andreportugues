---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { newsCopy } from '../../config/copy';
import { featuredNewsId, news, onAgendaNewsIds } from '../../data/news';
import Modal from '../ui/Modal.astro';

const featured = news.find((post) => post.id === featuredNewsId) ?? news[0];
const onAgenda = onAgendaNewsIds.map((id) => news.find((post) => post.id === id)).filter((post) => post !== undefined);
---

<section id="noticias" class="bg-surface py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-8">
    <div class="reveal mb-12 flex flex-col gap-5 border-l-4 border-brand-blue pl-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-2 text-sm font-extrabold uppercase tracking-eyebrow text-brand-navy">{newsCopy.kicker}</p>
        <h2 class="text-3xl font-extrabold uppercase tracking-[.15em] text-brand-blue md:text-5xl">{newsCopy.title}</h2>
      </div>
      <button
        type="button"
        data-news-list-open
        class="btn-navy inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-extrabold md:w-auto"
      >
        Mais conteúdo <ArrowRight size={18} stroke-width={2.5} />
      </button>
    </div>

    <div class="grid gap-10 md:grid-cols-[1.35fr_.65fr]">
      {
        featured && (
          <article class="news-featured-card card-lift reveal group">
            <div class="news-featured-image-frame relative mb-5 overflow-hidden rounded-2xl border border-surface bg-surface">
              <img src={featured.image} alt={featured.title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:opacity-95" />
            </div>
            <p class="mb-2 text-sm font-bold uppercase tracking-wider text-brand-navy">{featured.date}</p>
            <span class="inline-flex rounded bg-brand-yellow px-3 py-1 text-xs font-extrabold uppercase text-brand-blue">{featured.category}</span>
            <h3 class="mt-3 text-xl font-extrabold leading-tight text-brand-blue md:text-2xl">{featured.title}</h3>
            <p class="mt-3 text-lg font-bold leading-relaxed text-brand-blue">{featured.subtitle}</p>
            <button type="button" class="btn-navy mt-5 inline-flex items-center gap-2 rounded-full px-5 py-2 font-extrabold" data-news-id={featured.id}>
              Leia Mais <ArrowRight size={18} stroke-width={2.5} />
            </button>
          </article>
        )
      }

      <div class="reveal flex flex-col gap-5">
        <h3 class="border-b border-surface pb-3 font-extrabold text-brand-blue">EM PAUTA</h3>
        {
          onAgenda.map((post) => (
            <article class="group flex gap-4 border-b border-surface pb-5 last:border-b-0">
              <div class="h-24 w-28 shrink-0 overflow-hidden rounded-xl">
                <img src={post.image} alt={post.title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              </div>
              <div>
                <span class="text-xs font-extrabold uppercase text-brand-navy">{post.category}</span>
                <h4 class="mt-1 font-bold leading-snug text-brand-blue transition group-hover:text-brand-navy">{post.title}</h4>
                <span class="mt-2 block text-xs text-ink">{post.date}</span>
                <button type="button" class="btn-navy mt-3 inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-xs font-extrabold" data-news-id={post.id}>
                  Leia Mais <ArrowRight size={14} stroke-width={2.5} />
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<Modal id="news-list-modal" size="lg" eyebrow={newsCopy.kicker} title="Mais conteúdo" closeLabel="Fechar lista de matérias">
  <div data-list-items class="mt-5 grid gap-3"></div>
  <div class="modal-pager mt-6 flex items-center justify-between gap-4 border-t border-surface pt-5">
    <span data-list-label class="text-sm text-ink"></span>
    <div class="flex gap-2">
      <button type="button" class="pager-button" data-list-prev><ArrowLeft size={16} /> Anterior</button>
      <button type="button" class="pager-button" data-list-next>Próxima <ArrowRight size={16} /></button>
    </div>
  </div>
</Modal>

<script>
  import { news } from '../../data/news';
  import { createElement, newsToDetails, paginate, requestContentModal } from '../../lib/content';
  import { getModal, openModal } from '../../lib/modal';

  const openPost = (id: number) => {
    const post = news.find((item) => item.id === id);
    if (post) requestContentModal(newsToDetails(post));
  };

  document.querySelectorAll<HTMLButtonElement>('[data-news-id]').forEach((button) => {
    button.addEventListener('click', () => openPost(Number(button.dataset.newsId)));
  });

  const listModal = getModal('news-list-modal');
  const listItems = listModal?.querySelector('[data-list-items]');
  const listLabel = listModal?.querySelector('[data-list-label]');
  const prev = listModal?.querySelector<HTMLButtonElement>('[data-list-prev]');
  const next = listModal?.querySelector<HTMLButtonElement>('[data-list-next]');
  let page = 0;

  const render = () => {
    if (!listItems || !listLabel || !prev || !next) return;
    const result = paginate(news, page, 5);
    page = result.page;
    listItems.replaceChildren(
      ...result.items.map((post) => {
        const item = createElement('button', 'list-item');
        item.type = 'button';
        const image = createElement('img', 'h-16 w-24 shrink-0 rounded-lg object-cover');
        image.src = post.image;
        image.alt = '';
        image.loading = 'lazy';
        const copy = createElement('span', 'min-w-0');
        copy.append(
          createElement('small', 'block text-xs font-extrabold uppercase tracking-wider text-brand-navy', post.category || 'Redação'),
          createElement('strong', 'mt-1 block text-sm leading-snug text-brand-blue', post.title),
          createElement('span', 'mt-1 block truncate text-xs text-ink', post.subtitle),
        );
        item.append(image, copy);
        item.addEventListener('click', () => openPost(post.id));
        return item;
      }),
    );
    listLabel.textContent = result.label;
    prev.disabled = result.page === 0;
    next.disabled = result.page >= result.totalPages - 1;
  };

  document.querySelector('[data-news-list-open]')?.addEventListener('click', () => {
    page = 0;
    render();
    openModal(listModal);
  });
  prev?.addEventListener('click', () => {
    page -= 1;
    render();
  });
  next?.addEventListener('click', () => {
    page += 1;
    render();
  });
</script>
