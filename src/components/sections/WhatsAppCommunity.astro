---
import { ArrowUpRight } from '@lucide/astro';
import { participateCopy } from '../../config/copy';
import { candidate, communityLink, instagramProfile, whatsapp } from '../../config/site';

// Sem link da comunidade do WhatsApp, o bloco convida para o Instagram oficial.
const icon = communityLink.channel === 'whatsapp' ? whatsapp.icon : '/assets/social-instagram.webp';
---

<section id="participe" class="relative overflow-hidden bg-brand-blue py-20 text-white md:py-24">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span class="absolute -right-10 top-1/2 -translate-y-1/2 select-none font-display text-[16rem] font-extrabold leading-none text-white/[.06] md:text-[24rem]">
      {candidate.number}
    </span>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 md:px-8">
    <div class="grid items-center gap-12 md:grid-cols-[1.25fr_.75fr]">
      <div class="reveal">
        <p class="mb-4 flex items-center gap-3 text-sm font-extrabold uppercase tracking-eyebrow text-brand-yellow">
          <span class="inline-block h-1 w-8 bg-brand-yellow"></span>
          {participateCopy.kicker}
        </p>
        <h2 class="text-5xl font-extrabold uppercase leading-[0.95] md:text-7xl">
          {participateCopy.title}<br /><span class="text-brand-yellow">{participateCopy.titleHighlight}</span>
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/90">{participateCopy.text}</p>
      </div>

      <div class="reveal flex flex-col items-center justify-center">
        <div class="mb-4 text-center text-sm font-extrabold uppercase tracking-[.2em] text-white/75">{participateCopy.support}</div>
        <div class="flex h-32 w-32 items-center justify-center md:h-40 md:w-40">
          <img src={icon} alt="" class="h-full w-full object-contain brightness-0 invert" />
        </div>
        <a
          href={communityLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-6 inline-flex w-full max-w-xs items-center justify-center gap-2 rounded-full px-6 py-4 text-center font-extrabold"
        >
          {communityLink.label}
          <ArrowUpRight size={18} stroke-width={2.5} />
        </a>
        {communityLink.channel === 'instagram' && <p class="mt-3 text-sm font-bold text-white/75">{instagramProfile.handle}</p>}
      </div>
    </div>
  </div>
</section>
