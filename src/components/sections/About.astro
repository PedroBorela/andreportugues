---
import { aboutCopy } from '../../config/copy';
import { biography } from '../../data/case';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="quem-e" class="bg-white py-20 md:py-24">
  <div class="mx-auto grid max-w-7xl items-start gap-12 px-6 md:px-8 lg:grid-cols-[1.2fr_.8fr]">
    <div class="reveal">
      <SectionHeading eyebrow={aboutCopy.kicker} title={aboutCopy.title} />
      <p class="mt-6 text-lg leading-relaxed text-ink">{biography.text}</p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          biography.facts.map((fact) => (
            <div class="rounded-xl border border-surface bg-surface p-4">
              <dt class="text-xs font-extrabold uppercase tracking-wider text-brand-blue">{fact.label}</dt>
              <dd class="mt-1 font-bold text-brand-navy">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ol class="reveal relative space-y-8 border-l-4 border-brand-yellow pl-8">
      {
        biography.timeline.map((step) => (
          <li class="relative">
            <span class="absolute -left-[2.6rem] top-1 h-4 w-4 rounded-full border-4 border-white bg-brand-blue" aria-hidden="true" />
            <p class="font-display text-4xl font-extrabold text-brand-blue">{step.year}</p>
            <p class="mt-1 text-lg font-semibold text-brand-navy">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
