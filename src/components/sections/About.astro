---
import { aboutCopy } from '../../config/copy';
import { candidate, site } from '../../config/site';
import { biography } from '../../data/case';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="quem-e" class="overflow-hidden bg-white pt-20 md:pt-24">
  <div class="mx-auto grid max-w-7xl items-end gap-10 px-6 md:px-8 lg:grid-cols-[.85fr_1.15fr] lg:gap-16">
    <div class="reveal relative order-2 mx-auto w-full max-w-md lg:order-1">
      <div class="absolute inset-x-6 bottom-0 top-48 rounded-t-[2.5rem] bg-gradient-to-b from-brand-blue to-brand-navy" aria-hidden="true"></div>
      <span
        class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 select-none font-display text-[10rem] font-extrabold leading-none text-brand-yellow"
        aria-hidden="true"
      >
        {candidate.number}
      </span>
      <img
        src={site.photo}
        alt={`Foto oficial de ${candidate.name}`}
        width="900"
        height="1064"
        loading="lazy"
        class="relative mt-28 block h-auto w-full drop-shadow-2xl"
      />
    </div>

    <div class="reveal order-1 pb-4 lg:order-2 lg:pb-24">
      <SectionHeading eyebrow={aboutCopy.kicker} title={aboutCopy.title} />
      <p class="mt-6 text-lg leading-relaxed text-ink">{biography.text}</p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          biography.facts.map((fact) => (
            <div class="rounded-xl bg-surface p-4">
              <dt class="text-xs font-extrabold uppercase tracking-wider text-brand-blue">{fact.label}</dt>
              <dd class="mt-1 font-bold text-brand-navy">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <ol class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          biography.timeline.map((step) => (
            <li class="border-t-4 border-brand-yellow pt-3">
              <p class="font-display text-3xl font-extrabold text-brand-blue">{step.year}</p>
              <p class="mt-1 font-semibold leading-snug text-brand-navy">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
