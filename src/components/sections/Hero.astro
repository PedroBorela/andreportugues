---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { heroCopy } from '../../config/copy';
import { candidate, communityLink } from '../../config/site';

// Valor inicial calculado no build; o script atualiza no navegador.
const electionDay = new Date(`${candidate.electionDate}T00:00:00-03:00`);
const daysLeft = Math.max(0, Math.ceil((electionDay.getTime() - Date.now()) / 86_400_000));
---

<header id="inicio" class="relative overflow-hidden bg-brand-blue text-white">
  <div class="mx-auto max-w-[1440px]">
    <img
      src="/uploads/banner-andre-portugues-1080.webp"
      alt={heroCopy.bannerAlt}
      width="1440"
      height="640"
      fetchpriority="high"
      class="block h-auto w-full"
    />
  </div>

  <div class="clip-path-diagonal relative bg-gradient-to-b from-brand-blue to-brand-navy pb-24 pt-12 md:pt-16">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 md:px-8 lg:grid-cols-[1.35fr_.65fr]">
      <div class="reveal">
        <p class="mb-5 flex items-center gap-3 text-sm font-extrabold uppercase tracking-eyebrow text-brand-yellow">
          <span class="inline-block h-1 w-8 bg-brand-yellow"></span>
          {heroCopy.kicker}
        </p>
        <h1 class="mb-5 text-5xl font-extrabold uppercase leading-[0.95] md:text-7xl">
          {heroCopy.title} <em class="text-brand-yellow">{heroCopy.titleHighlight}</em>
        </h1>
        <p class="mb-8 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl">{heroCopy.subtitle}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href={heroCopy.primaryCta.href}
            class="btn-primary inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 font-extrabold uppercase"
          >
            {heroCopy.primaryCta.label}
            <ArrowRight size={18} stroke-width={2.5} />
          </a>
          <a
            href={communityLink.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-white/70 px-7 py-3 font-extrabold transition hover:border-white hover:bg-white/10"
          >
            {communityLink.label}
            <ArrowUpRight size={18} stroke-width={2.5} />
          </a>
        </div>
      </div>

      <div class="reveal">
        <div class="rounded-3xl border border-white/15 bg-white/10 p-7 text-center backdrop-blur-sm">
          <p class="text-sm font-extrabold uppercase tracking-eyebrow text-white/75">Faltam</p>
          <p class="font-display text-8xl font-extrabold leading-none text-brand-yellow md:text-9xl" data-countdown={candidate.electionDate}>
            {daysLeft}
          </p>
          <p class="mt-1 text-lg font-bold uppercase">
            <span data-countdown-unit>{daysLeft === 1 ? 'dia' : 'dias'}</span>{' '}
            {heroCopy.countdownLabel}
          </p>
          <ul class="mt-6 flex justify-center gap-4 border-t border-white/15 pt-5 text-xs font-extrabold uppercase tracking-[.16em] text-white/80">
            {heroCopy.values.map((value) => <li>{value}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const counter = document.querySelector<HTMLElement>('[data-countdown]');
  const unit = document.querySelector<HTMLElement>('[data-countdown-unit]');

  if (counter?.dataset.countdown) {
    const electionDay = new Date(`${counter.dataset.countdown}T00:00:00-03:00`);
    const days = Math.max(0, Math.ceil((electionDay.getTime() - Date.now()) / 86_400_000));
    counter.textContent = String(days);
    if (unit) unit.textContent = days === 1 ? 'dia' : 'dias';
  }
</script>
